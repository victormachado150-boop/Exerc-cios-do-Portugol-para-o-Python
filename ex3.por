programa {
  funcao inicio() {
    /*
    Média de três notas
    Aluno: Victor Mota Machado
    Objetivo: Fazer as Médias de três notas   
     */
     
     // Declaração de váriaveis 
     real nt1, nt2, nt3, media


     // Leitura das três notas
     escreva("Digite a primeira nota: ")
     leia(nt1)

     escreva("Digite a segunda nota: ")
     leia(nt2)

     escreva("Digite a terceira nota: ")
     leia(nt3)

     // Calculo da média 
     media = (nt1 + nt2 + nt3) / 3

     //Exibe
     escreva("\nA média fina é: ", media)
     
    
  }
}
